# ฐานข้อมูล (ตอนนี้ใช้ SQLite ตอน deploy จะเปลี่ยนเป็น Postgres)
DATABASE_URL="file:./dev.db"

# Auth.js: สร้างด้วย `npx auth secret` หรือ `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth (ไม่ต้องตั้งก็ได้ ถ้าไม่ใช้ปุ่ม Google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# อีเมลแจ้งเตือน (Gmail + App Password)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# รหัสลับสำหรับเรียก /api/cron/reminders สร้างด้วย node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""